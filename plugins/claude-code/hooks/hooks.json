{
  "description": "Load a repository's bounded Pomegr reporting policy into every Claude Code session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/policy.mjs\" hook --cwd \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
