{
  "name": "pomegr",
  "version": "0.5.3",
  "private": true,
  "description": "A local-first, read-only observer for coding-agent sessions.",
  "author": "Leandro Carvalho",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Lecarvalho/pomegr",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lecarvalho/pomegr.git"
  },
  "main": "desktop/runtime/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/run-vinext.mjs dev --hostname 0.0.0.0 --port 3003",
    "server": "node server/cli.mjs",
    "diagnostics:snapshot": "node scripts/diagnostics-snapshot.mjs",
    "diagnostics:analyze": "node scripts/diagnostics-logs.mjs",
    "diagnostics:logs": "node scripts/diagnostics-logs.mjs",
    "test:diagnostics": "node --test tests/server/session-trace-scope.test.mjs tests/server/diagnostics-logs.test.mjs tests/server/diagnostics/pipeline-log-stream.test.mjs tests/server/diagnostics/pipeline-log-writer.test.mjs",
    "mcp": "node mcp/server.mjs",
    "build:brand": "node scripts/export-brand-assets.mjs",
    "build": "npm run build:brand && npm run build:plugin && npm run desktop:legal && node scripts/run-vinext.mjs build",
    "build:plugin": "npm run build:plugin:claude && npm run build:plugin:codex",
    "build:plugin:claude": "node scripts/build-claude-plugin.mjs",
    "build:plugin:codex": "node scripts/build-codex-plugin.mjs",
    "start": "node server/web/cli.mjs",
    "desktop:legal": "node desktop/packaging/legal-notices.mjs",
    "desktop:prepare:from-build": "node desktop/packaging/build.mjs",
    "desktop:prepare": "npm run build && npm run desktop:prepare:from-build",
    "desktop:package": "npm run desktop:prepare && node desktop/packaging/prepare-builder-cache.mjs && set ELECTRON_BUILDER_CACHE=.electron-builder-cache&& electron-builder --win nsis portable --x64 && node desktop/packaging/finalize-package.mjs",
    "desktop:inspect": "node desktop/packaging/inspect-artifacts.mjs",
    "desktop:package:acceptance-prior": "npm run desktop:prepare && node desktop/packaging/build-acceptance-prior.mjs",
    "desktop:inspect:acceptance-prior": "node desktop/packaging/inspect-acceptance-prior.mjs",
    "desktop:beta:init": "node desktop/packaging/beta-acceptance.mjs init",
    "desktop:beta:verify": "node desktop/packaging/beta-acceptance.mjs verify",
    "desktop:update:verify-signature": "node desktop/packaging/update-signature-acceptance.mjs",
    "desktop:start": "npm run desktop:prepare && electron .",
    "desktop:runtime": "node node_modules/electron/install.js",
    "desktop:smoke": "set NODE_NO_WARNINGS=1&& set ELECTRON_RUN_AS_NODE=1&& node_modules\\electron\\dist\\electron.exe desktop/packaging/smoke-runner.mjs",
    "desktop:smoke:ci": "set POMEGR_SMOKE_RENDERER_MODE=runtime&& npm run desktop:smoke",
    "desktop:security": "node --test tests/desktop-claude-auth.test.mjs tests/desktop-claude-usage-setup.test.mjs tests/desktop-provider-settings.test.mjs tests/desktop-security.test.mjs tests/server/api-serialization.test.mjs tests/desktop-shell.test.mjs tests/desktop-behavior.test.mjs tests/desktop-notifications.test.mjs tests/desktop-updater.test.mjs tests/desktop-monitor-worker.test.mjs tests/desktop-runtime-seams.test.mjs tests/desktop-packaging.test.mjs tests/lan-network.test.mjs tests/lan-gateway.test.mjs tests/lan-sharing.test.mjs tests/vinext-lan-compat.test.mjs tests/lan-production.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "typecheck:provider-contract": "tsc -p tsconfig.provider-contract.json",
    "typecheck:provider-adapters": "tsc -p tsconfig.provider-adapters.json",
    "typecheck:landing": "npm --prefix landing run typecheck",
    "test:ops": "node --test tests/server/diagnostics/pipeline-operations.test.mjs && npm run test:diagnostics",
    "test:contracts": "node --test tests/server/normalize/work-kind.test.mjs tests/server/providers/provider-contract.test.mjs tests/server/providers/provider-registry.test.mjs tests/server/providers/provider-conformance.test.mjs tests/server/providers/provider-fixtures.test.mjs",
    "docs:providers": "node scripts/provider-capability-docs.mjs --write",
    "check:provider-docs": "node scripts/provider-capability-docs.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:boundaries": "depcruise vite.config.ts server app shared desktop mcp scripts landing/app landing/worker landing/scripts --config .dependency-cruiser.cjs --output-type err",
    "check:generated": "node scripts/check-generated-artifacts.mjs",
    "check": "npm run lint && npm run typecheck && npm run typecheck:provider-contract && npm run typecheck:provider-adapters && npm run typecheck:landing && npm run check:provider-docs && npm run check:architecture && npm run check:boundaries",
    "verify:fast": "npm run check && npm run test:contracts && npm run test:ops",
    "verify": "npm run check && npm run build && npm run check:generated && npm test && npm --prefix landing run test && npm --prefix landing run build:audit",
    "verify:desktop": "npm run desktop:runtime && npm run desktop:smoke && npm run desktop:security",
    "verify:desktop:ci": "npm run desktop:runtime && npm run desktop:smoke:ci && npm run desktop:security",
    "verify:release:local": "node scripts/verify-windows-release-local.mjs",
    "release:windows": "node scripts/release-windows-local.mjs",
    "check:release-source": "node scripts/check-release-source.mjs",
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "test:ui": "vitest run",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern landing/dist --ignore-pattern landing/.next --ignore-pattern landing/.vinext --ignore-pattern landing/.wrangler --ignore-pattern .impeccable --ignore-pattern .agents/skills/impeccable/scripts --ignore-pattern .next --ignore-pattern release --ignore-pattern release-acceptance --ignore-pattern .electron-builder-cache --ignore-pattern plugins/claude-code/**/*.bundle.mjs --ignore-pattern plugins/pomegr/**/*.bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.241",
    "@modelcontextprotocol/server": "^2.0.0",
    "electron-updater": "6.8.9",
    "next": "16.2.6",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vinext": "0.0.50",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electron/asar": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "dependency-cruiser": "^18.2.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.27.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "proper-lockfile": "4.1.2",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.14",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.pomegr.desktop",
    "productName": "Pomegr",
    "copyright": "Copyright © 2026 Leandro Carvalho",
    "electronDist": "node_modules/electron/dist",
    "afterPack": "desktop/packaging/after-pack.mjs",
    "electronUpdaterCompatibility": ">=2.16",
    "extraMetadata": {
      "pomegrPackagingScope": "POMEGR-DT-08-signed-updates"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lecarvalho",
        "repo": "pomegr"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "desktop/runtime/bounded-lifecycle.mjs",
      "desktop/runtime/artifact-privacy.mjs",
      "desktop/runtime/claude-auth.mjs",
      "desktop/runtime/claude-usage-setup.mjs",
      "desktop/runtime/desktop-behavior.mjs",
      "desktop/runtime/environment-policy.mjs",
      "desktop/runtime/lan-gateway.mjs",
      "desktop/runtime/lan-network.mjs",
      "desktop/runtime/lan-pairing-page.mjs",
      "desktop/runtime/lan-sharing.mjs",
      "desktop/runtime/main.mjs",
      "desktop/runtime/monitor-worker.mjs",
      "desktop/runtime/native-security.mjs",
      "desktop/runtime/notifications.mjs",
      "desktop/runtime/paths.mjs",
      "desktop/runtime/preload.cjs",
      "desktop/runtime/quiet-console.mjs",
      "desktop/runtime/report-save.mjs",
      "desktop/runtime/repository-inventory-action.mjs",
      "desktop/runtime/repository-plugin-action.mjs",
      "desktop/runtime/plugin-cli.mjs",
      "desktop/runtime/security-policy.mjs",
      "desktop/runtime/shell-stage.mjs",
      "desktop/runtime/settings.mjs",
      "desktop/runtime/provider-settings.mjs",
      "desktop/runtime/storage-settings.mjs",
      "desktop/runtime/shell-main.mjs",
      "desktop/runtime/shell-orchestrator.mjs",
      "desktop/runtime/startup-error.mjs",
      "desktop/runtime/updater.mjs",
      "desktop/runtime/utility-lifecycle.mjs",
      "desktop/workers/monitor-host.cjs",
      "desktop/workers/claude-statusline-bridge.cjs",
      "assets/brand/**/*",
      "build/icon.png",
      "shared/local-auth.mjs",
      "shared/agent-query-transport.mjs",
      "shared/local-service.mjs",
      "shared/pomegr-paths.mjs",
      "shared/session-route.mjs",
      "server/web/server.mjs",
      "dist/**/*",
      "LICENSE",
      "NOTICE",
      "SOURCE.md",
      "THIRD_PARTY_NOTICES.md",
      "TRADEMARKS.md",
      "!**/{test,tests,__tests__,fixtures,coverage}/**",
      "!**/{.claude,.codex,.git,.next,.vinext,.wrangler}/**",
      "!**/.env*",
      "!**/*.{map,ts,tsx,cts,mts,tsbuildinfo}"
    ],
    "asarUnpack": [
      "desktop/workers/**/*",
      "dist/**/*",
      "node_modules/@img/sharp-win32-x64/lib/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "legal/NOTICE"
      },
      {
        "from": "SOURCE.md",
        "to": "legal/SOURCE.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "TRADEMARKS.md",
        "to": "legal/TRADEMARKS.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Pomegr",
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "publisherName": "DSNK Technologie Inc"
      },
      "verifyUpdateCodeSignature": true,
      "legalTrademarks": "Pomegr"
    },
    "nsis": {
      "artifactName": "Pomegr-Setup-${version}-${arch}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Pomegr",
      "uninstallDisplayName": "Pomegr",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "Pomegr-Portable-${version}-${arch}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
