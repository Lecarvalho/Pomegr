{
  "description": "Load a repository's bounded Pomegr reporting policy, inject the applicable rows into declared subagent prompts, report a delegated agent that finished without reporting, and optionally check cached account-usage guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/policy.mjs\" hook --cwd \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/usage-guard.bundle.mjs\" --provider claude",
            "timeout": 5,
            "additionalContextLimit": 1600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/usage-guard.bundle.mjs\" --provider claude",
            "timeout": 5,
            "additionalContextLimit": 1600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/policy.mjs\" delegate --cwd \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_pomegr_pomegr__rename_session|mcp__pomegr__rename_session",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/rename-session.bundle.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/progress-reminder.bundle.mjs\" --cwd \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 5,
            "additionalContextLimit": 800
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/usage-guard.bundle.mjs\" --provider claude",
            "timeout": 5,
            "additionalContextLimit": 1600
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/usage-guard.bundle.mjs\" --provider claude",
            "timeout": 5,
            "additionalContextLimit": 1600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/policy.mjs\" subagent-stop --cwd \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
