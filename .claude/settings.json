{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-edit-check.mjs\"",
            "timeout": 60,
            "statusMessage": "Checking dependency boundaries"
          }
        ]
      }
    ]
  }
}
