{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pomegr-landing",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "pomegr.com",
			"custom_domain": true
		},
		{
			"pattern": "www.pomegr.com",
			"custom_domain": true
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		"not_found_handling": "none"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pomegr-waitlist",
			"database_id": "b38ccd26-069a-4f57-8c47-2927e0af776a",
			"migrations_dir": "db/migrations"
		},
		{
			"binding": "pomegr_waitlist",
			"database_name": "pomegr-waitlist",
			"database_id": "b38ccd26-069a-4f57-8c47-2927e0af776a",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "WAITLIST_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"WAITLIST_ORIGIN": "https://pomegr.com",
		"WAITLIST_HOST": "pomegr.com",
		"NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAESGUQtfQig7OgXm"
	},
	"observability": {
		"enabled": false
	}
}