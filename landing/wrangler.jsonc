{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pomegr-landing",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "pomegr.com", "custom_domain": true },
    { "pattern": "www.pomegr.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pomegr-waitlist",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "WAITLIST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "WAITLIST_ORIGIN": "https://pomegr.com",
    "WAITLIST_HOST": "pomegr.com",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY"
  },
  "observability": {
    "enabled": false
  }
}
