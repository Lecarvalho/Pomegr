# Files in this directory are served by the assets binding without running the Worker, so the
# security headers of worker/security-headers.ts are repeated here for them.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=()
  X-Frame-Options: DENY

# Cache content-hashed assets immutably. vinext writes this rule only when no _headers file exists.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
