# Local development only. Copy to .dev.vars; never commit that file.
# Cloudflare's published Turnstile test keys are suitable for local testing.
ENVIRONMENT=development
WAITLIST_ORIGIN=http://127.0.0.1:8788
WAITLIST_HOST=127.0.0.1:8788
WAITLIST_ALLOW_LOCAL_DEV=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
WAITLIST_COOKIE_SECRET=replace-with-at-least-32-random-bytes
